{%- comment -%}
  Section navigation beside a page.

  Workshop pages (sidebar nav "emip-YYYY" or "previous-workshops") get:
  that year's subpages, then every year as a compact list built from
  _data/editions.yml. Other pages get only the group of the main menu
  that contains them; pages outside any group get no rail.
{%- endcomment -%}
{%- assign nav_name = include.nav | append: '' -%}
{%- assign navigation = site.data.navigation[nav_name] -%}

{%- if nav_name contains 'emip-' or nav_name == 'previous-workshops' -%}
  {%- assign current_year = nav_name | remove: 'emip-' -%}
  {%- assign group = nil -%}
  {%- for item in navigation -%}
    {%- if item.children -%}{%- assign group = item -%}{%- endif -%}
  {%- endfor -%}
  {%- if group == nil -%}
    {%- for item in navigation -%}
      {%- if item.url == page.url -%}{%- assign group = item -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  <nav class="section-nav">
    {%- if group -%}
    <p class="rail-label">EMIP {{ current_year }}</p>
    <ul class="section-nav__list">
      <li><a href="{{ group.url | relative_url }}"{% if page.url == group.url %} aria-current="page"{% endif %}>Overview</a></li>
      {%- for child in group.children -%}
        <li><a href="{{ child.url | relative_url }}"{% if page.url == child.url %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
      {%- endfor -%}
    </ul>
    {%- endif -%}
    <p class="rail-label">All workshops</p>
    <ul class="year-list">
      {%- assign years = site.data.editions | reverse -%}
      {%- for e in years -%}
        {%- if e.in_year_list == false -%}{%- continue -%}{%- endif -%}
        {%- assign y = e.year | append: '' -%}
        <li><a href="{{ e.url | relative_url }}"{% if y == current_year %} aria-current="page"{% endif %}{% if e.status == 'planned' %} class="is-planned"{% endif %}>{{ e.year }}</a></li>
      {%- endfor -%}
    </ul>
  </nav>
{%- else -%}
  {%- assign group = nil -%}
  {%- for item in navigation -%}
    {%- if item.url == page.url -%}{%- assign group = item -%}{%- endif -%}
    {%- for child in item.children -%}
      {%- if child.url == page.url -%}{%- assign group = item -%}{%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- if group and group.children -%}
  <nav class="section-nav">
    <p class="rail-label">{{ group.short | default: group.title }}</p>
    <ul class="section-nav__list">
      <li><a href="{{ group.url | relative_url }}"{% if page.url == group.url %} aria-current="page"{% endif %}>Overview</a></li>
      {%- for child in group.children -%}
        <li><a href="{{ child.url | relative_url }}"{% if page.url == child.url %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
      {%- endfor -%}
    </ul>
  </nav>
  {%- endif -%}
{%- endif -%}
